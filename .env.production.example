# ═══════════════════════════════════════════════════════════════
# Panorama Seaside Studios — Production Environment Variables
# Copy to .env and fill in real values: cp .env.production.example .env
# Then secure it: chmod 600 .env
# ═══════════════════════════════════════════════════════════════

# MySQL is retired. Do not set DATABASE_URL or start a MySQL service.
# MongoDB holds rooms, bookings, channels, guests, and admins.
MONGODB_URI=mongodb://user:password@host:27017/panorama

# Optional one-time admin seed when the users collection has no admin.
# Create the admin in Mongo instead, and leave these empty in production
# if the account already exists. Password is hashed with bcrypt cost 12.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Application ─────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_64_CHAR_HEX
# Generate with: openssl rand -hex 32 (MUST be 64 hex chars for AES-256-GCM)
ENCRYPTION_KEY=CHANGE_ME_GENERATE_64_CHAR_HEX

# Your public URL (use IP for now, change to domain later)
NEXT_PUBLIC_APP_URL=http://46.62.134.239

# ─── Stripe test mode only (sk_live_ is refused) ───────────
STRIPE_SECRET_KEY=sk_test_XXXX
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_XXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXX

# ─── Resend (Email) ─────────────────────────────────────────
RESEND_API_KEY=re_XXXX

# ─── DeepL (Auto-Translation) ───────────────────────────────
DEEPL_API_KEY=XXXX

# ─── Telegram (Notifications) ───────────────────────────────
TELEGRAM_BOT_TOKEN=XXXX:XXXX
TELEGRAM_CHAT_ID=XXXX

# ─── Cloudinary (Image Upload) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=XXXX
CLOUDINARY_API_KEY=XXXX
CLOUDINARY_API_SECRET=XXXX

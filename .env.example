# MySQL is retired. Do not set DATABASE_URL. The app does not connect to MySQL.
#
# MongoDB holds guests, admins, rooms, bookings, blocked dates, pricing rules,
# channels, and contact messages.
# Collections: users, otp_challenges, rooms, bookings, blocked_dates,
# pricing_rules, channels, external_bookings, contact_submissions.
# Sessions are JWT cookies (guest_token, admin_token), not a Mongo sessions collection.
# Leave MONGODB_URI empty to disable sign-in (auth routes return 503). The public
# site still renders the five listing rooms from memory.
MONGODB_URI=""

# Admin account lives in MongoDB `users` with role "admin".
# Create that user in Mongo. If no admin exists and both variables below are
# set, the app seeds one account once (bcrypt cost 12, password never logged).
# Never commit a real password.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Optional pepper for OTP hashes. When empty, JWT_SECRET is used.
OTP_PEPPER=""

# JWT Secret for Admin Auth
JWT_SECRET="your-secure-random-secret-here"

# GDPR Encryption Key (AES-256-GCM) — KEEP THIS SECRET!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your-64-char-hex-key-here"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe test mode only. Live keys (sk_live_) are refused and card pay stays hidden.
# Checkout Sessions are created only when STRIPE_SECRET_KEY starts with sk_test_.
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email (Resend) — booking mail and the guest email OTP.
# When this is empty, OTP codes are written to the server log in development only
# and are never returned in API responses. Production without a key returns 503
# from register, sign-in, and OTP routes. SMTP is not wired; use RESEND_API_KEY.
RESEND_API_KEY=""

# DeepL Translation (free tier: 500K chars/month)
DEEPL_API_KEY="your-deepl-api-key"

# Telegram Notifications
TELEGRAM_BOT_TOKEN="your-bot-token-from-botfather"
TELEGRAM_CHAT_ID="your-chat-id"

# BTCPay Server (Bitcoin payments) — optional; leave empty to hide the option
BTCPAY_URL=""
BTCPAY_STORE_ID=""
BTCPAY_API_KEY=""
BTCPAY_WEBHOOK_SECRET=""

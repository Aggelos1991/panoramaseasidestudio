# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT Secret for Admin Auth
JWT_SECRET="your-secure-random-secret-here"

# GDPR Encryption Key (AES-256-GCM) — KEEP THIS SECRET!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your-64-char-hex-key-here"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email (Resend)
RESEND_API_KEY="re_..."

# DeepL Translation (free tier: 500K chars/month)
DEEPL_API_KEY="your-deepl-api-key"

# Telegram Notifications
TELEGRAM_BOT_TOKEN="your-bot-token-from-botfather"
TELEGRAM_CHAT_ID="your-chat-id"

# BTCPay Server (Bitcoin payments) — optional; leave empty to hide the option
BTCPAY_URL=""
BTCPAY_STORE_ID=""
BTCPAY_API_KEY=""
BTCPAY_WEBHOOK_SECRET=""
